# Required at bootstrap (not in DB)
DATABASE_URL=postgresql://bot:bot@localhost:5432/botdb
ENCRYPTION_KEY=          # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Seeded into config table on first run (can be changed via web panel later)
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
ALLOWED_CHAT_IDS=-100123456789
ADMIN_TELEGRAM_IDS=123456789

# Optional overrides (defaults shown)
CHAT_MODEL=gemini/gemini-2.5-pro
VISION_MODEL=gemini/gemini-2.0-flash
EMBEDDING_MODEL=gemini/gemini-embedding-001
SUMMARIZATION_MODEL=gemini/gemini-2.0-flash
